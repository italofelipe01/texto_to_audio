# Copie para .env e ajuste (todas as variáveis são opcionais).

# Porta da interface web no host (docker compose)
TTA_PORT=8000

# Motor de voz padrão: auto | edge | piper | gtts | espeak
TTA_ENGINE=auto
# Idioma padrão
TTA_LANG=pt-BR

# Perfil usado pela pasta monitorada (data/entrada): padrao | audiobook | podcast | acessibilidade | video | shorts | rascunho
TTA_WATCH_PRESET=padrao

# Desempenho
TTA_MAX_JOBS=2          # jobs simultâneos na interface web
TTA_MAX_WORKERS=4       # trechos sintetizados em paralelo por job
TTA_MAX_CHARS=500000    # limite de caracteres por texto
TTA_MAX_UPLOAD_MB=50    # limite por arquivo enviado

# Limpeza automática
TTA_JOB_TTL_DAYS=7      # apaga jobs concluídos após N dias (0 = nunca)
TTA_CACHE_MAX_MB=2048   # tamanho máximo do cache de trechos

# Voz offline Piper: baixa modelos automaticamente no primeiro uso
TTA_PIPER_AUTO_DOWNLOAD=true

# Redes corporativas: proxy para o Edge TTS e CA extra (inspeção TLS)
# TTA_PROXY=http://proxy.empresa:3128
# TTA_CA_BUNDLE=/data/ca-empresa.pem

# Dicionário de pronúncia global (padrão: data/pronuncia.txt)
# TTA_LEXICON=/data/pronuncia.txt
